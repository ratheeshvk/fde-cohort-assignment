DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fde_db

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
# First admin, created by: python init_db.py (no sign-up endpoint)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Comma-separated frontend origins allowed to send the login cookie
CORS_ORIGINS=http://localhost:5173
# Set to true once the site runs on HTTPS
COOKIE_SECURE=false
